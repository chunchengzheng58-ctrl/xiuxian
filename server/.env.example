HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./var/game.sqlite
# D 的服务凭证至少 32 个字符；缺省时内部接口关闭。不要填写玩家会话令牌。
HEALTH_SERVICE_TOKEN=
# 不设置 CORS_ORIGINS 时按实际 HOST/PORT 生成本机同源列表，改端口无需改此处。
# 公网、HTTPS 或反向代理部署请明确列出浏览器实际来源；显式列表不会自动加入本机来源。
# CORS_ORIGINS=https://game.example.com
# 可选：启动前设置 XIUXIAN_ENV_FILE 环境变量以替代本目录 .env；相对路径按 server 目录解析。
# XIUXIAN_ENV_FILE=D:/Projects/ChatGPT/涅槃/work/xiuxian-pages/work/runtime-config.env
